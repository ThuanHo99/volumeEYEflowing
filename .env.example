EXCHANGE_ID=binanceusdm
SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT,XRP/USDT:USDT
TIMEFRAMES=1m,5m,15m,1h,4h
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b-instruct
OLLAMA_TIMEOUT=60
MAX_CANDLES_PER_TF=500
NEWS_FETCH_INTERVAL=900
AI_INFERENCE_INTERVAL=300
WEB_USER=your-web-username
WEB_PASS=your-web-password

EVENT_CHECK_INTERVAL=3600
EVENT_WINDOW_DAYS=7
EVENTS_PATH=data/events/events.json

MIN_VOLUME_THRESHOLD=1.0
GRACE_PERIOD_MS=100

# Volume/price context v2 (default)
VS_ENABLED=true
VS_STRATEGY_MODE=context_v2
BINANCE_REST_URL=https://fapi.binance.com
BINANCE_WS_URL=wss://fstream.binance.com/market/stream?streams=
CORE_LEGACY_ALERTS_ENABLED=false
VS_KLINE_INTERVAL=1m
VS_CONTEXT_LOOKBACK_CANDLES=20
VS_CONTEXT_RVOL_MIN=2.0
VS_CONTEXT_LEVEL_TOLERANCE_PCT=0.05
VS_CONTEXT_CONFIRM_CANDLES=3
VS_CONTEXT_TELEGRAM_ALERTS_ENABLED=false
VS_ADAPTIVE_SHADOW_ENABLED=false
VS_ADAPTIVE_LOCAL_MODEL_ENABLED=false
VS_ADAPTIVE_MODEL=qwen3:0.6b-q4_K_M
VS_MIN_AVG_VOL_USDT=10000
VS_MAX_SYMBOLS=500

# Read-only Binance USD-M positioning/depth enrichment for context_v2.
# Top-trader account/position ratios currently require X-MBX-APIKEY per Binance docs.
# A read-only key is sufficient; no secret, signed request, or trading permission is used.
VS_DERIVATIVES_CONTEXT_ENABLED=true
VS_DERIVATIVES_PERIOD=5m
VS_DERIVATIVES_MAX_REQUESTS_5M=240
BINANCE_API_KEY=
